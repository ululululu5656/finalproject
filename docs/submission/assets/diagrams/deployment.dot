digraph Deployment {
  rankdir=LR;
  bgcolor=white;
  graph [fontname="Helvetica", fontsize=13];
  node  [fontname="Helvetica", fontsize=11, style=filled, fillcolor="#eef4ff", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=10, color="#333333"];

  device [shape=box3d,
          label="User Device\n--------------------\nWeb Browser\n(CafeFlow UI)"];
  server [shape=box3d,
          label="Application Server\n--------------------\nNode.js + Next.js\nAPI Route Handlers"];
  db     [shape=cylinder, fillcolor="#eefbf0",
          label="Database\n-----------\nSQLite file\ncafeflow.db"];

  device -> server [label="HTTP / HTTPS\n(JSON)"];
  server -> db [label="better-sqlite3\n(file I/O)"];
}
