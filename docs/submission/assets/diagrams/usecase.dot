digraph UseCase {
  rankdir=LR;
  graph [bgcolor=white, fontname="Helvetica", fontsize=14, labelloc=t];
  node  [fontname="Helvetica"];
  edge  [color="#475569", arrowhead=none];

  Admin [shape=box, style="rounded,filled", fillcolor="#fde68a", color="#b45309", width=1.1, label="Admin"];
  Staff [shape=box, style="rounded,filled", fillcolor="#bfdbfe", color="#1d4ed8", width=1.1, label="Staff"];

  subgraph cluster_sys {
    label="CafeFlow System";
    style="rounded"; color="#94a3b8"; fontsize=15; fontname="Helvetica-Bold";
    node [shape=ellipse, style=filled, fillcolor="#e0e7ff", color="#6366f1"];
    UC_auth   [label="Login / Logout"];
    UC_dash   [label="View Dashboard"];
    UC_menu   [label="Manage Menu"];
    UC_order  [label="Take & Track Orders"];
    UC_bill   [label="Generate Bills"];
    UC_inv    [label="Manage Inventory"];
    UC_report [label="View Reports"];
    UC_staff  [label="Manage Staff"];
  }

  Admin -> UC_auth;
  Admin -> UC_dash;
  Admin -> UC_menu;
  Admin -> UC_order;
  Admin -> UC_bill;
  Admin -> UC_inv;
  Admin -> UC_report;
  Admin -> UC_staff;

  Staff -> UC_auth;
  Staff -> UC_dash;
  Staff -> UC_order;
  Staff -> UC_bill;
}
