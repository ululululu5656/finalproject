digraph Methodology {
  layout=circo;
  bgcolor=white;
  graph [fontname="Helvetica", fontsize=13];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
          fillcolor="#eef4ff", color="#4a6fa5"];
  edge  [fontname="Helvetica", color="#333333"];

  Requirements -> Design -> Implementation -> Testing -> Review -> Requirements;
}
