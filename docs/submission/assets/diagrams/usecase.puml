@startuml
' Use case diagram of CafeFlow - proper UML notation (stick-figure actors)
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 150
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam actor {
  BackgroundColor #fde68a
  BorderColor #b45309
}
skinparam usecase {
  BackgroundColor #e0e7ff
  BorderColor #6366f1
}

actor "Admin" as Admin
actor "Staff" as Staff

rectangle "CafeFlow System" {
  usecase "Login / Logout"        as UC_auth
  usecase "View Dashboard"        as UC_dash
  usecase "Take & Track Orders"   as UC_order
  usecase "Generate Bills"        as UC_bill
  usecase "Manage Menu"           as UC_menu
  usecase "Manage Inventory"      as UC_inv
  usecase "View Reports"          as UC_report
  usecase "Manage Staff"          as UC_staff
}

' Shared use cases
Staff --> UC_auth
Staff --> UC_dash
Staff --> UC_order
Staff --> UC_bill

' Admin has full access
Admin --> UC_auth
Admin --> UC_dash
Admin --> UC_order
Admin --> UC_bill
Admin --> UC_menu
Admin --> UC_inv
Admin --> UC_report
Admin --> UC_staff
@enduml
