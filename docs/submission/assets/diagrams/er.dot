graph ER {
  // Entity Relationship diagram of CafeFlow - Chen notation
  // Entities = rectangles, Relationships = diamonds, Attributes = ellipses (PK underlined)
  layout=neato;
  overlap=false;
  splines=true;
  sep="+8";
  bgcolor=white;
  node [fontname="Helvetica", fontsize=11];
  edge [color="#475569", fontname="Helvetica", fontsize=10];

  // ---------- Entities ----------
  node [shape=box, style="filled,bold", fillcolor="#dbeafe", color="#1d4ed8", fontsize=13];
  E_users           [label="users"];
  E_sessions        [label="sessions"];
  E_menu            [label="menu_items"];
  E_inventory       [label="inventory_items"];
  E_orders          [label="orders"];
  E_orderitems      [label="order_items"];

  // ---------- Relationships ----------
  node [shape=diamond, style=filled, fillcolor="#fde68a", color="#b45309", fontsize=11];
  R_has       [label="Has"];
  R_contains  [label="Contains"];
  R_snapshot  [label="Captures"];

  // ---------- Attributes ----------
  node [shape=ellipse, style=filled, fillcolor="#f1f5f9", color="#64748b", fontsize=10];

  // users
  u_id    [label=<<u>id</u>>];
  u_name  [label="name"];
  u_email [label="email"];
  u_role  [label="role"];
  u_phone [label="phone"];
  u_pass  [label="password_hash"];
  u_cat   [label="created_at"];

  // sessions
  s_token [label=<<u>token</u>>];
  s_uid   [label=<<i>user_id</i> (FK)>];
  s_cat   [label="created_at"];

  // menu_items
  m_id    [label=<<u>id</u>>];
  m_name  [label="name"];
  m_cat   [label="category"];
  m_price [label="price"];
  m_avail [label="available"];
  m_desc  [label="description"];

  // inventory_items
  i_id    [label=<<u>id</u>>];
  i_name  [label="name"];
  i_qty   [label="quantity"];
  i_unit  [label="unit"];
  i_low   [label="low_stock_threshold"];
  i_cat   [label="category"];

  // orders
  o_id    [label=<<u>id</u>>];
  o_table [label="table_number"];
  o_cust  [label="customer_name"];
  o_stat  [label="status"];
  o_total [label="total"];
  o_cat   [label="created_at"];
  o_uat   [label="updated_at"];

  // order_items
  oi_id    [label=<<u>id</u>>];
  oi_oid   [label=<<i>order_id</i> (FK)>];
  oi_mid   [label=<<i>menu_item_id</i> (FK)>];
  oi_name  [label="name"];
  oi_price [label="price"];
  oi_qty   [label="quantity"];

  // ---------- Attribute edges ----------
  E_users -- {u_id u_name u_email u_role u_phone u_pass u_cat};
  E_sessions -- {s_token s_uid s_cat};
  E_menu -- {m_id m_name m_cat m_price m_avail m_desc};
  E_inventory -- {i_id i_name i_qty i_unit i_low i_cat};
  E_orders -- {o_id o_table o_cust o_stat o_total o_cat o_uat};
  E_orderitems -- {oi_id oi_oid oi_mid oi_name oi_price oi_qty};

  // ---------- Relationship edges (with cardinality) ----------
  E_users      -- R_has       [label="1", len=1.6];
  R_has        -- E_sessions  [label="N", len=1.6];

  E_orders     -- R_contains  [label="1", len=1.6];
  R_contains   -- E_orderitems[label="N", len=1.6];

  E_menu       -- R_snapshot  [label="1", len=1.6];
  R_snapshot   -- E_orderitems[label="N", len=1.6];
}
