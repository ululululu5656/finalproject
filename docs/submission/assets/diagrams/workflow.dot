digraph Workflow {
  rankdir=LR;
  bgcolor=white;
  graph [fontname="Helvetica", fontsize=13];
  node  [fontname="Helvetica", fontsize=11, style="rounded,filled", fillcolor="#eef4ff", color="#4a6fa5"];
  edge  [fontname="Helvetica", color="#333333"];

  start [shape=circle, fillcolor="#eefbf0", label="Start", width=0.6];
  build [shape=box, label="Staff selects\nmenu items"];
  submit[shape=box, label="Submit order\n(table, customer)"];
  pend  [shape=box, label="Pending"];
  prep  [shape=box, label="Preparing"];
  comp  [shape=box, label="Completed"];
  bill  [shape=box, label="Generate &\nprint bill"];
  end   [shape=doublecircle, fillcolor="#eefbf0", label="End", width=0.6];

  start -> build -> submit -> pend;
  pend -> prep [label="Start Preparing"];
  prep -> comp [label="Mark Complete"];
  comp -> bill -> end;
}
