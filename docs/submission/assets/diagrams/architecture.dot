digraph Architecture {
  rankdir=TB;
  bgcolor=white;
  graph [fontname="Helvetica", fontsize=13, compound=true];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=10, color="#333333"];

  subgraph cluster_client {
    label="Presentation Tier  -  Web Browser"; fontname="Helvetica-Bold";
    style=filled; fillcolor="#f4f8ff"; color="#4a6fa5";
    UI    [label="Next.js / React UI\n(pages + UI components)"];
    store [label="Zustand State Stores\n(auth, menu, orders, ...)"];
  }

  subgraph cluster_server {
    label="Application Tier  -  Next.js / Node.js"; fontname="Helvetica-Bold";
    style=filled; fillcolor="#eef2fb"; color="#4a6fa5";
    api  [label="API Route Handlers\n/api/auth, /api/menu, /api/orders ..."];
    auth [label="Auth Module\n(bcrypt + cookie sessions)"];
    repo [label="Data Access Layer\n(repository functions)"];
  }

  db [label="Data Tier  -  SQLite Database\n(better-sqlite3, cafeflow.db)", shape=cylinder, fillcolor="#eefbf0", color="#4a6fa5"];

  UI -> store [dir=both, label="render / update"];
  store -> api [label="fetch (JSON over HTTP)"];
  api -> auth [label="guard"];
  api -> repo [label="query"];
  auth -> db;
  repo -> db [label="SQL"];
}
